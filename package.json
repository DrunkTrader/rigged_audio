{
  "name": "rigged-audio",
  "version": "0.1.0",
  "description": "Local-first desktop stem separation workspace",
  "author": "Rigged Audio contributors",
  "license": "GPL-3.0-only",
  "homepage": "https://github.com/DrunkTrader/rigged_audio",
  "repository": {
    "type": "git",
    "url": "https://github.com/DrunkTrader/rigged_audio.git"
  },
  "desktopName": "rigged-audio",
  "private": true,
  "main": "dist-electron/main/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.node.json && vite build",
    "dev": "npm run build && electron .",
    "start": "electron .",
    "dist": "npm run build && electron-builder --publish never",
    "dist:win": "npm run build && electron-builder --win nsis portable --x64 --publish never && node scripts/write-checksums.mjs",
    "dist:linux": "npm run build && electron-builder --linux AppImage deb --x64 --publish never && node scripts/write-checksums.mjs",
    "dist:mac": "npm run build && electron-builder --mac dmg zip --x64 --arm64 --publish never && node scripts/write-checksums.mjs",
    "release:check": "node scripts/check-release.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "ffmpeg-static": "^5.3.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "global-agent": "^4.1.7",
    "minimatch@9": "^11.0.5",
    "minimatch@10": "^11.0.5"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true,
    "electron-winstaller@5.4.0": true
  }
}
